# wgs-aggregate -- cohort aggregation of per-sample WGS pipeline outputs.
# Dataset-agnostic: all paths + sample identity come from the config (deps/outs/
# params; see README.md + docs/samplesheet_contract.md). Config is supplied via
# --configfile (run.sh passes it); there is no hardcoded configfile here.
#
#   snakemake --use-conda --configfile config/config.yaml -jN            # all steps
#   snakemake --use-conda --configfile config/config.yaml -jN sash       # one step

from snakemake.utils import min_version, validate

min_version("7.32.0")

# Fail fast with a clear message on a missing/misnamed key, rather than deep
# inside a rule. Schema: workflow/schemas/config.schema.yaml.
validate(config, "schemas/config.schema.yaml")

deps   = config["deps"]
outs   = config["outs"]
params = config["params"]

# Shared paths, the single r_cmd() dispatch helper, the per-step table lists, and
# targets(). Defined once here; used by every rules/<step>.smk below.
include: "rules/common.smk"


rule all:
    input:
        targets(),


# Per-step phony aliases (clean targets for callers, e.g. `snakemake sash`).
rule sash:
    input: expand(AGG("sash", "{t}"), t=SASH_TABLES)
rule oncoanalyser:
    input: expand(AGG("oncoanalyser", "{t}"), t=ONCO_TABLES)
rule oncoanalyser_dna_rna:
    input: expand(AGG("oncoanalyser_dna_rna", "{t}"), t=DNARNA_TABLES)
rule dragen:
    input: expand(AGG("dragen", "{t}"), t=DRAGEN_TABLES)
rule report_index:
    input: expand(REPORTS + "/{t}.csv", t=REPORT_INDICES)
rule germline:
    input: GERMLINE_VCF


include: "rules/sash.smk"
include: "rules/oncoanalyser.smk"
include: "rules/oncoanalyser_dna_rna.smk"
include: "rules/dragen.smk"
include: "rules/report_index.smk"
include: "rules/germline.smk"
